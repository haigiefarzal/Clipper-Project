* text=auto

# Skrip Windows wajib CRLF, skrip Mac wajib LF
*.bat     text eol=crlf
*.command text eol=lf
*.sh      text eol=lf

# Tidak ikut di ZIP rilis (website GitHub Pages & file git)
docs/          export-ignore
functions/     export-ignore
netlify.toml   export-ignore
.gitattributes export-ignore
.gitignore     export-ignore

# File biner
*.ttf    binary
*.otf    binary
*.onnx   binary
*.png    binary
*.jpg    binary
*.mp4    binary
*.mp3    binary
*.wav    binary
